[Unit]
Description=Music Assistant private local web player
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/env node %h/.local/share/omarchy-ma-player/daemon.mjs
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=10
UMask=0077
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
